# 统一换行符为 LF（避免 Windows/macOS/Linux 协作者产生整文件 diff）
* text=auto eol=lf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# 文本类文件强制 LF
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.md   text eol=lf

# lock 文件在 diff 中折叠（它们通常很长且机器生成）
package-lock.json -diff linguist-generated